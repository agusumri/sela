<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "installer": the Inno Setup installer Sela-Setup-<version>.exe.
     The Sela.exe inside it is already signed in the previous request (see .github/workflows/release.yml).
     product-name / product-version are enforced, as the SignPath Foundation terms require.
     Paste this into SignPath > Project "sela" > Artifact configurations. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Sela-Setup-${version}.exe" product-name="Sela" product-version="${version}" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
