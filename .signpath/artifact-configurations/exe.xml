<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "exe": the self-contained single-file Sela.exe.
     actions/upload-artifact uploads a ZIP, so the root element is <zip-file>.
     Paste this into SignPath > Project "sela" > Artifact configurations. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Sela.exe" product-name="Sela" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
