<Window x:Class="Sela.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Sela"
        Width="520" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#111111"
        Foreground="#F2F2F2"
        BorderBrush="#2A2A2A" BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sela;component/Assets/SelaIcon.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palette -->
            <SolidColorBrush x:Key="Bg" Color="#111111" />
            <SolidColorBrush x:Key="Card" Color="#1A1A1A" />
            <SolidColorBrush x:Key="CardLine" Color="#262626" />
            <SolidColorBrush x:Key="Field" Color="#0C0C0C" />
            <SolidColorBrush x:Key="FieldLine" Color="#333333" />
            <SolidColorBrush x:Key="Text" Color="#F2F2F2" />
            <SolidColorBrush x:Key="TextDim" Color="#A3A3A3" />
            <SolidColorBrush x:Key="Green" Color="#3DDC97" />
            <SolidColorBrush x:Key="Blue" Color="#4C9BFF" />
            <SolidColorBrush x:Key="Danger" Color="#FF7A7A" />
            <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- Keyboard focus ring -->
            <Style x:Key="FocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="#F2F2F2"
                                       StrokeThickness="1.5" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section card -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Card}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Display}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="17" />
            </Style>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- Toggle switch: BorderBrush is the accent color -->
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent" MinHeight="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True" />
                                <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11"
                                        Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#BDBDBD"
                                             HorizontalAlignment="Left" Margin="4,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbX" X="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter TargetName="Thumb" Property="Fill" Value="#0A0A0A" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X"
                                                                 To="18" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SwitchBlue" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
                <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
            </Style>

            <!-- Compact pill toggle for prayers: BorderBrush is the accent -->
            <Style x:Key="Chip" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Pill" CornerRadius="16" Padding="12,7,14,7" Background="#141414"
                                    BorderBrush="#333333" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="Transparent" Stroke="#6B6B6B" StrokeThickness="1.5" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter TargetName="Pill" Property="Background" Value="#14271F" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter TargetName="Dot" Property="Stroke" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="#1F1F1F" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Pill" Property="Background" Value="#183326" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented control segment: BorderBrush is the accent -->
            <Style x:Key="Segment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Seg" CornerRadius="8" Padding="0,7" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Seg" Property="Background" Value="#222222" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Seg" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter Property="Foreground" Value="#0A0A0A" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SegmentBlue" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
                <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
            </Style>
            <Style x:Key="SegmentTrack" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Field}" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="3" />
            </Style>

            <!-- Text inputs -->
            <Style x:Key="FieldBox" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Field}" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="38" />
            </Style>
            <Style x:Key="BareText" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="CaretBrush" Value="{StaticResource Text}" />
                <Setter Property="SelectionBrush" Value="#3DDC97" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style x:Key="BarePassword" TargetType="PasswordBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="CaretBrush" Value="{StaticResource Text}" />
                <Setter Property="SelectionBrush" Value="#4C9BFF" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="BaseButton" TargetType="ButtonBase">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Background" Value="#242424" />
                <Setter Property="BorderBrush" Value="#333333" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="B" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="B" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource Green}" />
                <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                <Setter Property="Foreground" Value="#0A0A0A" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#333333" />
            </Style>
            <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Small text link (e.g. "Bawaan" reset) -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="6,4">
                                <ContentPresenter x:Name="C" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Thin volume slider: green fill, round thumb -->
            <Style x:Key="SliderFill" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Grid Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="VolumeSlider" TargetType="Slider">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="SmallChange" Value="5" />
                <Setter Property="LargeChange" Value="10" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Track x:Name="PART_Track" MinHeight="24">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource Green}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="#333333"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="T" Width="16" Height="16" Fill="#F2F2F2"
                                                         Stroke="{StaticResource Green}" StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Fill" Value="#FFFFFF" />
                                                        <Setter TargetName="T" Property="StrokeThickness" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- City results -->
            <Style x:Key="ResultItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnResultClicked" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="R" CornerRadius="8" Padding="12,8" Background="Transparent"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="R" Property="Background" Value="#232323" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="R" Property="Background" Value="#14271F" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource Green}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Storyboard x:Key="Spin" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                 From="0" To="360" Duration="0:0:0.9" />
            </Storyboard>

            <!-- Entrance: cards slide up, staggered -->
            <Storyboard x:Key="Enter">
                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="BodyShift" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag area via WindowChrome) -->
        <Grid Grid.Row="0" Margin="18,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource SelaLogo}" Width="24" Height="24" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo Sela" />
                <TextBlock Text="Sela" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="Pengaturan" Foreground="{StaticResource TextDim}" Margin="8,1,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Content="&#xE8BB;" Click="OnCancel"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Tutup" ToolTip="Tutup (Esc)" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="18,4,18,4">
            <StackPanel x:Name="Body" Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="BodyShift" />
                </StackPanel.RenderTransform>

                <!-- Lokasi -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Lokasi" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="#14271F" CornerRadius="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="CurrentCityText" Text="Kota Jakarta" Foreground="{StaticResource Green}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <Border x:Name="SearchField" Style="{StaticResource FieldBox}">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Cari kota atau kabupaten…"
                                           Foreground="#7A7A7A" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareText}"
                                         TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown"
                                         GotKeyboardFocus="OnFieldFocus" LostKeyboardFocus="OnFieldBlur"
                                         AutomationProperties.Name="Cari kota atau kabupaten" />
                            </Grid>
                        </Border>

                        <!-- Search status / results -->
                        <StackPanel x:Name="SearchStatus" Orientation="Horizontal" Margin="4,10,0,0" Visibility="Collapsed">
                            <Ellipse x:Name="Spinner" Width="14" Height="14" Stroke="{StaticResource Green}" StrokeThickness="2"
                                     StrokeDashArray="4 2.5" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0"
                                     VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock x:Name="SearchStatusText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <ListBox x:Name="ResultsList" Margin="0,8,0,0" MaxHeight="184" Visibility="Collapsed"
                                 Background="{StaticResource Field}" BorderBrush="{StaticResource FieldLine}"
                                 BorderThickness="1" Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ResultItem}"
                                 KeyDown="OnResultsKeyDown"
                                 AutomationProperties.Name="Hasil pencarian kota">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ScrollViewer Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding Province}" FontSize="11" Foreground="#9A9A9A">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Province}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Jadwal dari Kemenag RI via myquran.com" Style="{StaticResource Hint}" Margin="2,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Sholat -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Sholat" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                        <TextBlock Text="Waktu wajib" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="PSubuh" Content="Subuh" Style="{StaticResource Chip}" />
                            <CheckBox x:Name="PDzuhur" Content="Dzuhur" Style="{StaticResource Chip}" />
                            <CheckBox x:Name="PAshar" Content="Ashar" Style="{StaticResource Chip}" />
                            <CheckBox x:Name="PMaghrib" Content="Maghrib" Style="{StaticResource Chip}" />
                            <CheckBox x:Name="PIsya" Content="Isya" Style="{StaticResource Chip}" />
                        </WrapPanel>

                        <TextBlock Text="Tambahan" Style="{StaticResource Hint}" Margin="0,6,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="PImsak" Content="Imsak" Style="{StaticResource Chip}" />
                            <CheckBox x:Name="PTerbit" Content="Terbit" Style="{StaticResource Chip}" />
                            <CheckBox x:Name="PDhuha" Content="Dhuha" Style="{StaticResource Chip}" />
                        </WrapPanel>

                        <TextBlock Text="Ingatkan sebelum waktu sholat" Style="{StaticResource Label}" Margin="0,10,0,8" />
                        <Border Style="{StaticResource SegmentTrack}">
                            <UniformGrid Rows="1" x:Name="PrayerSoonGroup">
                                <RadioButton GroupName="Soon" Tag="0" Content="Mati" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Soon" Tag="5" Content="5 menit" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Soon" Tag="10" Content="10 menit" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Soon" Tag="15" Content="15 menit" Style="{StaticResource Segment}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Adzan -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Adzan" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                        <CheckBox x:Name="AdhanToggle" Content="Putar adzan saat masuk waktu sholat"
                                  Style="{StaticResource Switch}" Checked="OnAdhanToggled" Unchecked="OnAdhanToggled" />

                        <StackPanel x:Name="AdhanOptions">
                            <CheckBox x:Name="AdhanMuteToggle" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="Bisukan sementara">
                                <StackPanel>
                                    <TextBlock Text="Bisukan sementara" />
                                    <TextBlock Text="Adzan tidak bunyi, pengingat tetap muncul" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>

                            <TextBlock Text="Putar untuk" Style="{StaticResource Hint}" Margin="0,12,0,8" />
                            <WrapPanel>
                                <CheckBox x:Name="ASubuh" Content="Subuh" Style="{StaticResource Chip}" />
                                <CheckBox x:Name="ADzuhur" Content="Dzuhur" Style="{StaticResource Chip}" />
                                <CheckBox x:Name="AAshar" Content="Ashar" Style="{StaticResource Chip}" />
                                <CheckBox x:Name="AMaghrib" Content="Maghrib" Style="{StaticResource Chip}" />
                                <CheckBox x:Name="AIsya" Content="Isya" Style="{StaticResource Chip}" />
                            </WrapPanel>

                            <DockPanel Margin="0,8,0,4">
                                <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Text="80%" Foreground="{StaticResource Green}"
                                           FontWeight="SemiBold" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Text="Volume" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE992;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}"
                                        ValueChanged="OnVolumeChanged" AutomationProperties.Name="Volume adzan" />
                                <TextBlock Grid.Column="2" Text="&#xE995;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>

                            <TextBlock Text="Suara" Style="{StaticResource Hint}" Margin="0,14,0,8" />
                            <Border Background="{StaticResource Field}" BorderBrush="{StaticResource FieldLine}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,4,4,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Adzan -->
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Adzan" />
                                        <TextBlock x:Name="AdhanFileText" Text="Bawaan" Style="{StaticResource Hint}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button x:Name="AdhanResetButton" Grid.Row="0" Grid.Column="1" Content="Bawaan"
                                            Style="{StaticResource LinkButton}" Click="OnResetAdhanFile" Margin="0,0,4,0"
                                            AutomationProperties.Name="Pakai suara adzan bawaan" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="Pilih file…" Style="{StaticResource GhostButton}"
                                            Padding="12,6" FontSize="12" Click="OnPickAdhanFile" VerticalAlignment="Center"
                                            AutomationProperties.Name="Pilih file suara adzan" />
                                    <Button x:Name="AdhanPreview" Grid.Row="0" Grid.Column="3" Style="{StaticResource IconButton}"
                                            Content="&#xE768;" Foreground="{StaticResource Green}" Margin="4,0,0,0"
                                            Click="OnPreviewAdhan" AutomationProperties.Name="Putar contoh adzan" ToolTip="Putar contoh" />

                                    <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#222222" Margin="0,0,8,0" />

                                    <!-- Adzan Subuh -->
                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Adzan Subuh" />
                                        <TextBlock x:Name="SubuhFileText" Text="Bawaan" Style="{StaticResource Hint}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button x:Name="SubuhResetButton" Grid.Row="2" Grid.Column="1" Content="Bawaan"
                                            Style="{StaticResource LinkButton}" Click="OnResetSubuhFile" Margin="0,0,4,0"
                                            AutomationProperties.Name="Pakai suara adzan Subuh bawaan" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="Pilih file…" Style="{StaticResource GhostButton}"
                                            Padding="12,6" FontSize="12" Click="OnPickSubuhFile" VerticalAlignment="Center"
                                            AutomationProperties.Name="Pilih file suara adzan Subuh" />
                                    <Button x:Name="SubuhPreview" Grid.Row="2" Grid.Column="3" Style="{StaticResource IconButton}"
                                            Content="&#xE768;" Foreground="{StaticResource Green}" Margin="4,0,0,0"
                                            Click="OnPreviewSubuh" AutomationProperties.Name="Putar contoh adzan Subuh" ToolTip="Putar contoh" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Meeting -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Meeting" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                        <CheckBox x:Name="OutlookToggle" Content="Outlook (aplikasi klasik)" Style="{StaticResource SwitchBlue}" />

                        <TextBlock Text="Google Calendar" Style="{StaticResource Label}" Margin="0,12,0,8" />
                        <Border x:Name="GoogleField" Style="{StaticResource FieldBox}">
                            <Grid Margin="12,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GooglePlaceholder" Text="Tempel alamat rahasia iCal"
                                           Foreground="#7A7A7A" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <PasswordBox x:Name="GooglePassword" Style="{StaticResource BarePassword}"
                                             PasswordChanged="OnGooglePasswordChanged"
                                             GotKeyboardFocus="OnFieldFocus" LostKeyboardFocus="OnFieldBlur"
                                             AutomationProperties.Name="Alamat rahasia iCal Google Calendar" />
                                <TextBox x:Name="GoogleText" Style="{StaticResource BareText}" Visibility="Collapsed"
                                         SelectionBrush="#4C9BFF"
                                         TextChanged="OnGoogleTextChanged"
                                         GotKeyboardFocus="OnFieldFocus" LostKeyboardFocus="OnFieldBlur"
                                         AutomationProperties.Name="Alamat rahasia iCal Google Calendar" />
                                <ToggleButton x:Name="RevealToggle" Grid.Column="1" Style="{StaticResource IconButton}"
                                              Content="&#xE7B3;" Checked="OnRevealChanged" Unchecked="OnRevealChanged"
                                              AutomationProperties.Name="Tampilkan alamat" ToolTip="Tampilkan alamat" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="GoogleError" Foreground="{StaticResource Danger}" FontSize="12" Margin="2,6,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                                   Text="Alamat harus diawali https:// atau webcal://" />
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0"
                                   Text="Buka Google Calendar di web → Setelan → pilih kalender → Integrasikan kalender → salin 'Alamat rahasia dalam format iCal'. Alamat ini rahasia, disimpan terenkripsi di perangkat ini." />

                        <TextBlock Text="Ingatkan meeting tanpa pengingat" Style="{StaticResource Label}" Margin="0,14,0,8" />
                        <Border Style="{StaticResource SegmentTrack}">
                            <UniformGrid Rows="1" x:Name="MeetingGroup">
                                <RadioButton GroupName="Meet" Tag="5" Content="5 menit" Style="{StaticResource SegmentBlue}" />
                                <RadioButton GroupName="Meet" Tag="10" Content="10 menit" Style="{StaticResource SegmentBlue}" />
                                <RadioButton GroupName="Meet" Tag="15" Content="15 menit" Style="{StaticResource SegmentBlue}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Umum -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Umum" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutostartToggle" Content="Mulai bersama Windows" Style="{StaticResource Switch}" />
                        <CheckBox x:Name="IdleToggle" Content="Tampilkan notch saat diam" Style="{StaticResource Switch}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="#222222" BorderThickness="0,1,0,0" Background="#0D0D0D" Padding="18,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="OnCancel" />
                <Button x:Name="SaveButton" Content="Simpan" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
