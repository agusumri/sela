<Window x:Class="Sela.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:n="clr-namespace:Sela.Views.Notch"
        xmlns:l="clr-namespace:Sela.Localization"
        Title="Sela" Width="520" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Foreground="#F5F5F7"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
  <Window.Resources>
   <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/Sela;component/Assets/SelaIcon.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- palette -->
    <Color x:Key="SholatColor">#3DDC97</Color>
    <Color x:Key="MeetingColor">#4C9BFF</Color>
    <SolidColorBrush x:Key="Ink" Color="#000000"/>
    <SolidColorBrush x:Key="Surface" Color="#0F0F11"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1A1A1D"/>
    <SolidColorBrush x:Key="Hairline" Color="#1E1E22"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9C9CA3"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#6B6B73"/>
    <SolidColorBrush x:Key="Sholat" Color="{StaticResource SholatColor}"/>
    <SolidColorBrush x:Key="SholatSoft" Color="{StaticResource SholatColor}" Opacity="0.13"/>
    <SolidColorBrush x:Key="SholatChip" Color="{StaticResource SholatColor}" Opacity="0.2"/>
    <SolidColorBrush x:Key="Meeting" Color="{StaticResource MeetingColor}"/>
    <SolidColorBrush x:Key="MeetingSoft" Color="{StaticResource MeetingColor}" Opacity="0.09"/>
    <SolidColorBrush x:Key="MeetingEdge" Color="{StaticResource MeetingColor}" Opacity="0.45"/>
    <SolidColorBrush x:Key="MeetingChip" Color="{StaticResource MeetingColor}" Opacity="0.14"/>
    <!-- Google calendar: a muted warm tint, distinct from both the sholat green and the Outlook blue -->
    <Color x:Key="GoogleColor">#E9C46A</Color>
    <SolidColorBrush x:Key="Google" Color="{StaticResource GoogleColor}"/>
    <SolidColorBrush x:Key="GoogleChip" Color="{StaticResource GoogleColor}" Opacity="0.13"/>

    <!-- Arabic: classic naskh faces first, Segoe UI covers any machine without them -->
    <FontFamily x:Key="ArabicFont">Traditional Arabic, Arabic Typesetting, Segoe UI</FontFamily>

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3" CornerRadius="16" BorderThickness="1.5" BorderBrush="#E6FFFFFF"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- solid pill, used for Join (blue) and Coba lagi (green) -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Meeting}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="14" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- green outline pill: stop the adzan without leaving the card -->
    <Style x:Key="OutlineButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Sholat}"/>
      <Setter Property="BorderBrush" Value="#993DDC97"/>
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="11,5,13,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="14" Padding="{TemplateBinding Padding}" BorderThickness="1"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource SholatSoft}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Sholat}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- quiet round icon button (settings) -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="14" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceRaised}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- quiet green text button (show / hide the full Arabic) -->
    <Style x:Key="TextLink" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Sholat}"/>
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" Padding="0,2" Opacity="0.85">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slim overlay scrollbar for the dark panel: 4 px rounded thumb, ~40% white, no arrows -->
    <Style x:Key="SlimBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="4" HorizontalAlignment="Center">
              <Track.Thumb>
                <Thumb Cursor="Arrow">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="2" Background="#66FFFFFF"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SlimScroll" TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SlimBar}" Orientation="Vertical"
                         HorizontalAlignment="Right" Opacity="0" Cursor="Arrow"
                         Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                         Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- one half of the Sholat | Agenda switch; the sliding thumb lives behind both -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="NotchTabs"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D0D0D6"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Prayer row: a dot on the day's timeline, name, and a right-aligned tabular time.
         The dot column is 30 wide so every dot centers on x=15, where the timeline line runs. -->
    <DataTemplate DataType="{x:Type n:PrayerRow}">
      <Border x:Name="Row" Height="36" CornerRadius="18" Padding="0,0,14,0" Background="Transparent" BorderThickness="1"
              BorderBrush="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="Halo" Width="14" Height="14" Fill="{StaticResource SholatChip}" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#3A3A40" Stroke="#000000" StrokeThickness="0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"
                     Margin="4,0,0,1"/>
          <Border x:Name="Chip" Grid.Column="2" Visibility="Collapsed" CornerRadius="10" Padding="8,2"
                  Background="{StaticResource SholatChip}" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Countdown}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Sholat}"
                       Typography.NumeralAlignment="Tabular"/>
          </Border>
          <TextBlock x:Name="Time" Grid.Column="3" Text="{Binding TimeText}" FontSize="14" VerticalAlignment="Center"
                     FontFamily="{StaticResource DisplayFont}" Typography.NumeralAlignment="Tabular" Margin="0,0,0,1"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSecondary}" Value="True">
          <Setter TargetName="Row" Property="Height" Value="28"/>
          <Setter TargetName="Dot" Property="Width" Value="5"/>
          <Setter TargetName="Dot" Property="Height" Value="5"/>
          <Setter TargetName="Dot" Property="Fill" Value="#2E2E34"/>
          <Setter TargetName="Name" Property="FontSize" Value="12.5"/>
          <Setter TargetName="Name" Property="FontWeight" Value="Normal"/>
          <Setter TargetName="Time" Property="FontSize" Value="12.5"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPassed}" Value="True">
          <Setter TargetName="Row" Property="Opacity" Value="0.7"/>
          <Setter TargetName="Dot" Property="Fill" Value="#5E5E66"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNext}" Value="True">
          <Setter TargetName="Row" Property="Background">
            <Setter.Value>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#2A3DDC97" Offset="0"/>
                <GradientStop Color="#123DDC97" Offset="1"/>
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
          <Setter TargetName="Row" Property="BorderBrush" Value="#263DDC97"/>
          <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Sholat}"/>
          <Setter TargetName="Dot" Property="Effect">
            <Setter.Value>
              <DropShadowEffect Color="{StaticResource SholatColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
            </Setter.Value>
          </Setter>
          <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Sholat}"/>
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="Time" Property="Foreground" Value="{StaticResource Sholat}"/>
          <Setter TargetName="Time" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="Chip" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type n:AgendaRow}">
      <Border x:Name="Card" CornerRadius="18" Background="#0E0E10" BorderBrush="Transparent"
              BorderThickness="1" Padding="14,11" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/><ColumnDefinition Width="2"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding StartText}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                       Typography.NumeralAlignment="Tabular"/>
            <TextBlock Text="{Binding EndText}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,1,0,0"
                       Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
          <Rectangle Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{StaticResource Meeting}" Opacity="0.85" Margin="0,4"/>
          <StackPanel Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Subject}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Subject}"/>
            <DockPanel Margin="0,4,0,0" LastChildFill="True">
              <!-- source chip: tiny glyph + name, tinted per calendar -->
              <Border x:Name="Src" DockPanel.Dock="Left" CornerRadius="7" Padding="6,1,7,1" Background="{StaticResource MeetingChip}"
                      VerticalAlignment="Center" AutomationProperties.Name="{Binding SourceLabel}" ToolTip="{Binding SourceLabel}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SrcGlyph" Style="{StaticResource Icon}" Text="{Binding SourceGlyph}" FontSize="9.5"
                             Foreground="{StaticResource Meeting}" Margin="0,1,4,0"/>
                  <TextBlock x:Name="SrcText" Text="{Binding SourceText}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{StaticResource Meeting}" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="Loc" Margin="8,0,0,0" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Location}">
                <Run Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                <Run Text="{Binding Location, Mode=OneWay}"/>
              </TextBlock>
            </DockPanel>
          </StackPanel>
          <Button x:Name="Join" Grid.Column="3" Style="{StaticResource PillButton}" Padding="14,5" Content="{Binding [Notch_Join], Source={x:Static l:Loc.Instance}}"
                  Tag="{Binding JoinUrl}" Click="AgendaJoin_Click" Visibility="Collapsed"
                  AutomationProperties.Name="{Binding Subject, StringFormat='Join {0}'}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasJoin}" Value="True">
          <Setter TargetName="Join" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsGoogle}" Value="True">
          <Setter TargetName="Src" Property="Background" Value="{StaticResource GoogleChip}"/>
          <Setter TargetName="SrcGlyph" Property="Foreground" Value="{StaticResource Google}"/>
          <Setter TargetName="SrcText" Property="Foreground" Value="{StaticResource Google}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasLocation}" Value="False">
          <Setter TargetName="Loc" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNow}" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{StaticResource MeetingSoft}"/>
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource MeetingEdge}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPast}" Value="True">
          <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- "ibadah hari ini" pill: outline when not yet (click = Sudah), soft green with a check once done -->
    <DataTemplate DataType="{x:Type n:HabitRow}">
      <!-- compact tile: ring/check centered above the label; the strip lays three of these out in equal columns -->
      <Button x:Name="Pill" Click="HabitPill_Click" Tag="{Binding Habit}" Cursor="Hand" Margin="3,0"
              FocusVisualStyle="{StaticResource FocusRing}" ToolTip="{Binding Hint}" ToolTipService.ShowOnDisabled="True"
              AutomationProperties.Name="{Binding Hint}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Height="44" CornerRadius="12" Padding="4,0" BorderThickness="1"
                    BorderBrush="#2A2A30" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#993DDC97"/>
                <Setter TargetName="B" Property="Background" Value="#0F3DDC97"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Background" Value="{StaticResource SholatSoft}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#333DDC97"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel>
          <Grid Width="13" Height="13" HorizontalAlignment="Center">
            <Ellipse x:Name="Ring" Stroke="#5E5E66" StrokeThickness="1.2"/>
            <TextBlock x:Name="Check" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource Sholat}" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center"
                     Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter TargetName="Pill" Property="IsEnabled" Value="False"/>
          <Setter TargetName="Pill" Property="Cursor" Value="Arrow"/>
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Sholat}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
   </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <StackPanel x:Name="Shape" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                MouseEnter="Shape_MouseEnter" MouseLeave="Shape_MouseLeave">
      <StackPanel.Effect>
        <DropShadowEffect x:Name="ShapeShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
      </StackPanel.Effect>
      <!-- concave ears let the shape melt into the top edge -->
      <Path x:Name="EarLeft" Width="10" Height="10" VerticalAlignment="Top" Fill="{StaticResource Ink}" Data="M0,0 H10 V10 A10,10 0 0 0 0,0 Z"/>
              <Border x:Name="Island" Background="{StaticResource Ink}" Width="280" Height="40" CornerRadius="0,0,20,20"
              VerticalAlignment="Top" Cursor="Hand" ClipToBounds="True"
              MouseLeftButtonUp="Island_MouseLeftButtonUp">
        <!-- Stage is a fixed 420x420 surface kept centered inside the morphing island, so content never jumps -->
        <Canvas x:Name="StageHost">
          <Grid x:Name="Stage" Width="420" Height="420">

            <!-- 1. idle pill -->
            <Grid x:Name="IdleLayer" Width="280" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <!-- [sky orb] [current prayer / "Berikutnya Ashar 14:51"] [countdown]: one centered group -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The orb is drawn for a 30 DIP box (14 DIP visible). Scaled ×23/14 so the visible orb (23 DIP) spans the
                     two-line block from line 1's cap top to line 2's baseline (measured: 23.2 DIP). The box becomes
                     49.3 DIP: margins trim its empty glow area (13.15 DIP a side) so the group centers on the visible orb,
                     the layout height stays inside the 40 DIP pill, and orb → text is 11 DIP. The faint outer glow
                     runs past the pill edge and is clipped by the island, where it has already faded to near zero. -->
                <n:SelaMascot x:Name="Mascot" Width="30" Height="30" Margin="-13.15,-4.65,-2.15,-4.65" VerticalAlignment="Center"
                              IsHitTestVisible="False" Focusable="False">
                  <n:SelaMascot.LayoutTransform>
                    <ScaleTransform ScaleX="1.6428571" ScaleY="1.6428571"/>
                  </n:SelaMascot.LayoutTransform>
                </n:SelaMascot>
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,1">
                  <TextBlock x:Name="IdlePrimary" Text="Sela" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                             Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock x:Name="IdleSecondary" FontSize="11" FontFamily="{StaticResource DisplayFont}" Margin="0,-1,0,0"
                             Foreground="{StaticResource TextSecondary}" Typography.NumeralAlignment="Tabular" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="IdleCountdown" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                           Foreground="{StaticResource Sholat}" Margin="14,0,0,1" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" Visibility="Collapsed"/>
                <!-- static hint that the adzan is still sounding (stop it from the glance) -->
                <TextBlock x:Name="IdleAdhan" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource Sholat}" Opacity="0.7" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>

            <!-- 2. glance -->
            <Grid x:Name="GlanceLayer" Width="380" Height="158" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <Grid Margin="18,10,18,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="30"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button x:Name="GlanceStop" Grid.Row="3" Style="{StaticResource OutlineButton}" Margin="0,6,0,0" Padding="0,5"
                        HorizontalAlignment="Stretch" Visibility="Collapsed" Click="StopAdhan_Click"
                        ToolTip="{Binding [Notch_StopAdhanHint], Source={x:Static l:Loc.Instance}}" AutomationProperties.Name="{Binding [Notch_StopAdhan], Source={x:Static l:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE198;" FontSize="12" Foreground="{StaticResource Sholat}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Notch_StopAdhan], Source={x:Static l:Loc.Instance}}" Foreground="{StaticResource Sholat}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- same tile-less mark as the panel tab bar; -4 left cancels the glow's transparent margin -->
                  <Image Source="{StaticResource SelaMarkOnBlack}" Height="25" VerticalAlignment="Center" Margin="-4,0,0,0"
                         Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
                         Focusable="False" AutomationProperties.Name="Sela"/>
                  <!-- now → next as a small timeline: the track runs from the current period's start (left)
                       to the next prayer (right); the dot is "now". The Label gives screen readers one sentence. -->
                  <Label x:Name="GlancePrayerBlock" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,0,0,0" Padding="0"
                         VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Background="Transparent"
                         Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource DisplayFont}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <!-- labels sit over the two ends of the track -->
                      <TextBlock x:Name="GlanceNowLabel" Text="{Binding [Notch_GlanceNow], Source={x:Static l:Loc.Instance}}"
                                 FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}"/>
                      <TextBlock x:Name="GlanceNextLabel" Grid.Column="1" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,0"
                                 Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"/>
                      <TextBlock x:Name="GlanceNow" Grid.Row="1" FontSize="15.5" FontWeight="SemiBold" Foreground="#D6D6DB"/>
                      <TextBlock x:Name="GlancePrayer" Grid.Row="1" Grid.Column="1" FontSize="15.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                      <!-- decorative progress track: elapsed part in soft green, dot = now, end tick = next prayer -->
                      <Grid x:Name="GlanceTrack" Grid.Row="2" Grid.ColumnSpan="2" Height="7" Margin="0,5,0,4" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition x:Name="GlanceTrackDone" Width="0*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="GlanceTrackLeft" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" Height="3" CornerRadius="1.5" Background="#1C1C20"/>
                        <Border Height="3" CornerRadius="1.5">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Offset="0" Color="#263DDC97"/>
                              <GradientStop Offset="1" Color="#8C3DDC97"/>
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <Ellipse Grid.Column="2" Width="5" Height="5" HorizontalAlignment="Right" Fill="#3A3A40"/>
                        <!-- zero-width column: the dot hangs centered on the boundary -->
                        <Ellipse Grid.Column="1" Width="7" Height="7" Margin="-3.5,0" Fill="{StaticResource Sholat}"
                                 Stroke="{StaticResource Ink}" StrokeThickness="1.5"/>
                      </Grid>
                      <TextBlock x:Name="GlanceSince" Grid.Row="3" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                 Typography.NumeralAlignment="Tabular"/>
                      <TextBlock x:Name="GlancePrayerTime" Grid.Row="3" Grid.Column="1" FontSize="11.5" HorizontalAlignment="Right"
                                 Foreground="{StaticResource TextSecondary}" Typography.NumeralAlignment="Tabular"/>
                      <!-- fixed slot: "12j 59m 59d" fits at 19 px, right-aligned so only the digits change; level with the names -->
                      <TextBlock x:Name="GlanceCountdown" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="10,0,0,0"
                                 FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Sholat}"
                                 Width="110" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                  </Label>
                  <!-- no schedule / no next prayer -->
                  <StackPanel x:Name="GlanceFallback" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,0,0,0" VerticalAlignment="Center"
                              Visibility="Collapsed">
                    <TextBlock Text="Sela" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                    <TextBlock x:Name="GlanceFallbackText" FontFamily="{StaticResource DisplayFont}" FontSize="15.5" FontWeight="SemiBold"/>
                  </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource Hairline}" Margin="0,5,0,0"/>
                <Grid Grid.Row="2" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="13" Foreground="{StaticResource Meeting}"
                             Width="32" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="GlanceMeeting" Grid.Column="1" Margin="12,0,8,0" FontSize="12.5" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="GlanceMeetingMeta" Grid.Column="2" FontSize="11.5" VerticalAlignment="Center"
                             Foreground="{StaticResource TextSecondary}" Typography.NumeralAlignment="Tabular"><Run x:Name="GlanceMeetingWhen"/><Run x:Name="GlanceMeetingSep" Foreground="{StaticResource TextTertiary}"/><Run x:Name="GlanceMeetingSrc" FontWeight="SemiBold"/></TextBlock>
                  <Button x:Name="GlanceJoin" Grid.Column="3" Style="{StaticResource PillButton}" Content="{Binding [Notch_Join], Source={x:Static l:Loc.Instance}}" Padding="12,3"
                          FontSize="11.5" Margin="10,0,0,0" Visibility="Collapsed" Focusable="False" Click="GlanceJoin_Click"
                          ToolTip="{Binding [Notch_JoinHint], Source={x:Static l:Loc.Instance}}"/>
                </Grid>
              </Grid>
            </Grid>

            <!-- 3. panel -->
            <!-- Height is set from code to fit the active tab (260..412), so the sheet's hairline sits on the real bottom -->
            <Grid x:Name="PanelLayer" Width="344" Height="412" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed" Cursor="Arrow">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <!-- sheet surface: a faint top-to-bottom lift and a hairline that follows the rounded bottom edge -->
              <Border x:Name="PanelSheet" CornerRadius="0,0,30,30" BorderThickness="0,0,0,1" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000000" Offset="0"/>
                    <GradientStop Color="#000000" Offset="0.35"/>
                    <GradientStop Color="#0C0C0E" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#24FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <Grid Margin="20,14,20,22">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- top bar: centered segmented switch, quiet settings on the right -->
                <Grid x:Name="PanelTop">
                  <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                  <!-- 200 wide, centered between the mark (ends x 33) and refresh (starts x 248): ~7.5 DIP gap each side -->
                  <Border Width="200" Height="30" CornerRadius="15" Background="#141417" BorderBrush="#1C1C20" BorderThickness="1"
                          Padding="2" HorizontalAlignment="Center" Margin="0,0,23,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Border x:Name="SegmentThumb" CornerRadius="12.5" Background="#2A2A30">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <Border.RenderTransform><TranslateTransform x:Name="SegmentShift"/></Border.RenderTransform>
                      </Border>
                      <RadioButton x:Name="TabSholat" Style="{StaticResource Segment}" FontSize="12" Content="{Binding [Notch_TabSholat], Source={x:Static l:Loc.Instance}}" IsChecked="True" Checked="Tab_Checked"/>
                      <RadioButton x:Name="TabAgenda" Grid.Column="1" Style="{StaticResource Segment}" FontSize="12" Content="{Binding [Notch_TabAgenda], Source={x:Static l:Loc.Instance}}" Checked="Tab_Checked"/>
                      <RadioButton x:Name="TabHadits" Grid.Column="2" Style="{StaticResource Segment}" FontSize="12" Content="{Binding [Notch_TabHadits], Source={x:Static l:Loc.Instance}}" Checked="Tab_Checked"/>
                    </Grid>
                  </Border>
                  <!-- brand mark at the left end of the tab bar, on every tab -->
                  <!-- tile-less mark for the black panel: 25 DIP tall ≈ 19 DIP crescent, ~37 wide with the dot.
                       -4 left cancels the glow's transparent margin so the crescent lines up with the content edge. -->
                  <Image x:Name="PanelLogo" Source="{StaticResource SelaMarkOnBlack}" Height="25" HorizontalAlignment="Left"
                         VerticalAlignment="Center" Margin="-4,0,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                         IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Sela"/>
                  <!-- refresh: turns slowly while a manual refresh runs (dimmed instead when OS animations are off) -->
                  <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,0,28,0" Click="Retry_Click"
                          ToolTip="{Binding [Notch_Refresh], Source={x:Static l:Loc.Instance}}" ToolTipService.ShowOnDisabled="True"
                          AutomationProperties.Name="{Binding [Notch_Refresh], Source={x:Static l:Loc.Instance}}">
                    <TextBlock x:Name="RefreshIcon" Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12.5" RenderTransformOrigin="0.5,0.5">
                      <TextBlock.RenderTransform><RotateTransform x:Name="RefreshSpin"/></TextBlock.RenderTransform>
                    </TextBlock>
                  </Button>
                  <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,0,-4,0" Click="Settings_Click"
                          ToolTip="{Binding [Notch_Settings], Source={x:Static l:Loc.Instance}}" AutomationProperties.Name="{Binding [Notch_Settings], Source={x:Static l:Loc.Instance}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13"/>
                  </Button>
                </Grid>

                <!-- quiet status under the top bar: offline, or when a cached agenda was last updated -->
                <StackPanel x:Name="StatusLine" Grid.Row="1" Orientation="Horizontal" Margin="4,10,4,-4" Height="16"
                            Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Name="StatusGlyph" Style="{StaticResource Icon}" FontSize="10.5" Foreground="{StaticResource TextTertiary}"
                             Margin="0,1,6,0"/>
                  <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <!-- Sholat -->
                <Grid x:Name="SholatPage" Grid.Row="2" Margin="0,16,0,0">
                  <Grid x:Name="SholatContent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="SholatHeader" Margin="4,0,4,12">
                      <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock x:Name="CityText" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="GregorianText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock x:Name="HijriText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Sholat}" Opacity="0.85"
                                 VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                    </Grid>
                    <!-- the day as a thin timeline: track through every dot, green fill up to the next prayer -->
                    <Grid Grid.Row="1">
                      <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="TimelineTrack" Width="2" RadiusX="1" RadiusY="1" Fill="#1F1F24" Canvas.Left="15"/>
                        <Rectangle x:Name="TimelineFill" Width="2" RadiusX="1" RadiusY="1" Canvas.Left="15">
                          <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                              <GradientStop Color="#003DDC97" Offset="0"/>
                              <GradientStop Color="#993DDC97" Offset="1"/>
                            </LinearGradientBrush>
                          </Rectangle.Fill>
                        </Rectangle>
                      </Canvas>
                      <ItemsControl x:Name="PrayerList" Focusable="False" IsTabStop="False" SizeChanged="PrayerList_SizeChanged"/>
                    </Grid>
                  </Grid>
                  <StackPanel x:Name="SholatEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                              Margin="0,0,0,24">
                    <Grid Width="52" Height="52" HorizontalAlignment="Center">
                      <Ellipse Fill="{StaticResource SurfaceRaised}"/>
                      <TextBlock Style="{StaticResource Icon}" Text="&#xEB55;" FontSize="20" Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                    <TextBlock Text="{Binding [Notch_ScheduleUnavailable], Source={x:Static l:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding [Notch_CheckInternet], Source={x:Static l:Loc.Instance}}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <Button Style="{StaticResource PillButton}" Background="{StaticResource Sholat}" Foreground="#000000"
                            x:Name="SholatRetry" HorizontalAlignment="Center" Margin="0,16,0,0" Click="Retry_Click"/>
                  </StackPanel>
                </Grid>

                <!-- Agenda -->
                <Grid x:Name="AgendaPage" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                  <Grid x:Name="AgendaContent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="AgendaHeader" Margin="4,0,4,12">
                      <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding [Notch_Today], Source={x:Static l:Loc.Instance}}" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                        <TextBlock x:Name="AgendaDate" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock x:Name="AgendaCount" Grid.Column="1" FontSize="12" Foreground="{StaticResource Meeting}"
                                 VerticalAlignment="Bottom"/>
                    </Grid>
                    <!-- long lists dissolve into the bottom curve instead of being cut off -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False" PanningMode="VerticalOnly">
                      <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#FF000000" Offset="0"/>
                          <GradientStop Color="#FF000000" Offset="0.9"/>
                          <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                      </ScrollViewer.OpacityMask>
                      <ItemsControl x:Name="AgendaList" Focusable="False" IsTabStop="False"/>
                    </ScrollViewer>
                  </Grid>
                  <StackPanel x:Name="AgendaEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                              Margin="0,0,0,24">
                    <Grid Width="52" Height="52" HorizontalAlignment="Center">
                      <Ellipse Fill="{StaticResource SurfaceRaised}"/>
                      <TextBlock x:Name="AgendaEmptyIcon" Style="{StaticResource Icon}" Text="&#xE787;" FontSize="20"
                                 Foreground="{StaticResource Meeting}"/>
                    </Grid>
                    <TextBlock x:Name="AgendaEmptyTitle" Text="{Binding [Notch_NoAgenda], Source={x:Static l:Loc.Instance}}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="AgendaEmptyBody" Text="{Binding [Notch_TimeToFocus], Source={x:Static l:Loc.Instance}}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" Margin="0,3,0,0"/>
                    <Button x:Name="AgendaRetry" Style="{StaticResource PillButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Click="Retry_Click" Visibility="Collapsed"/>
                  </StackPanel>
                </Grid>

                <!-- Hadits: today's hadith, then a pinned "ibadah hari ini" strip -->
                <Grid x:Name="HaditsPage" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid x:Name="HaditsContent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel x:Name="HaditsHeader" Margin="4,0,4,10">
                      <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                      <TextBlock x:Name="HadithSource" FontSize="11.5" Foreground="{StaticResource Sholat}" Opacity="0.85"
                                 Typography.NumeralAlignment="Tabular"/>
                      <TextBlock x:Name="HadithTitle" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                 TextWrapping="Wrap" LineHeight="21" Margin="0,3,0,0"/>
                    </StackPanel>
                    <!-- slim scrollbar while it overflows and the pointer is over it; the bottom fade drops once scrolled to the end
                         (code). Transparent background so the wheel works over the gaps between lines too. -->
                    <ScrollViewer x:Name="HaditsScroll" Grid.Row="1" Style="{StaticResource SlimScroll}" VerticalScrollBarVisibility="Auto"
                                  Focusable="False" PanningMode="VerticalOnly" Background="Transparent" ScrollChanged="HaditsScroll_ScrollChanged">
                      <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#FF000000" Offset="0"/>
                          <GradientStop Color="#FF000000" Offset="0.88"/>
                          <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                      </ScrollViewer.OpacityMask>
                      <!-- 10 on the right keeps the RTL text clear of the slim scrollbar -->
                      <StackPanel x:Name="HaditsBody" Margin="4,0,10,26" SizeChanged="HaditsBody_SizeChanged">
                        <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                        <!-- clamped to 4 lines (MaxHeight set from code) so the translation stays on screen -->
                        <TextBlock x:Name="HadithArabic" FlowDirection="RightToLeft" TextAlignment="Left" TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontFamily="{StaticResource ArabicFont}" FontSize="20" LineHeight="36"
                                   LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource TextPrimary}"
                                   xml:lang="ar"/>
                        <Button x:Name="ArabicToggle" Style="{StaticResource TextLink}" HorizontalAlignment="Left" Margin="0,2,0,-4"
                                Visibility="Collapsed" Click="ArabicToggle_Click"/>
                        <Rectangle Height="1" Fill="{StaticResource Hairline}" Margin="0,12,0,12" Width="48" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="HadithIndonesian" FlowDirection="LeftToRight" TextWrapping="Wrap" FontSize="13.5" LineHeight="21"
                                   Foreground="#D6D6DB" MaxWidth="300" HorizontalAlignment="Left"/>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                  <StackPanel x:Name="HaditsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                              Margin="0,0,0,12">
                    <Grid Width="52" Height="52" HorizontalAlignment="Center">
                      <Ellipse Fill="{StaticResource SurfaceRaised}"/>
                      <TextBlock x:Name="HaditsEmptyIcon" Style="{StaticResource Icon}" Text="&#xE82D;" FontSize="20"
                                 Foreground="{StaticResource Sholat}"/>
                    </Grid>
                    <TextBlock x:Name="HaditsEmptyTitle" Text="{Binding [Notch_HadithUnavailable], Source={x:Static l:Loc.Instance}}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="HaditsEmptyBody" Text="{Binding [Notch_CheckInternet], Source={x:Static l:Loc.Instance}}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <Button x:Name="HaditsRetry" Style="{StaticResource PillButton}" Background="{StaticResource Sholat}" Foreground="#000000"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Click="Retry_Click"/>
                  </StackPanel>

                  <!-- ibadah hari ini -->
                  <Grid x:Name="HabitStrip" Grid.Row="1" Margin="4,8,4,0">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding [Notch_HabitsToday], Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,6"/>
                    <!-- equal columns for however many habits are enabled; -3 cancels the tiles' outer 3 px gap -->
                    <ItemsControl x:Name="HabitList" Grid.Row="1" Margin="-3,0" Focusable="False" IsTabStop="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </Grid>
                </Grid>

              </Grid>
            </Grid>

            <!-- 4. reminder card -->
            <Grid x:Name="ReminderLayer" Width="380" Height="92" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <!-- icon / title / badge row: 56 tall; 32 with a dhikr (icon 32), where it becomes the small context line (set from code) -->
              <Grid x:Name="ReminderContent" Margin="20,12,18,0" Height="56" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="ReminderIconBox" Width="40" Height="40" VerticalAlignment="Center">
                  <Ellipse x:Name="ReminderIconBg"/>
                  <TextBlock x:Name="ReminderIcon" Style="{StaticResource Icon}" FontSize="18"/>
                  <!-- while the adzan sounds the crescent gives way to three slow sound bars -->
                  <StackPanel x:Name="AdhanWave" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Height="16" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Sholat}" RenderTransformOrigin="0.5,0.5">
                      <Rectangle.RenderTransform><ScaleTransform x:Name="Wave1" ScaleY="0.45"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Sholat}" Margin="3,0" RenderTransformOrigin="0.5,0.5">
                      <Rectangle.RenderTransform><ScaleTransform x:Name="Wave2" ScaleY="0.85"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Sholat}" RenderTransformOrigin="0.5,0.5">
                      <Rectangle.RenderTransform><ScaleTransform x:Name="Wave3" ScaleY="0.6"/></Rectangle.RenderTransform>
                    </Rectangle>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                  <DockPanel LastChildFill="True">
                    <!-- meeting cards lead with where the event came from -->
                    <Border x:Name="ReminderSource" DockPanel.Dock="Left" CornerRadius="7" Padding="6,1,7,1" Margin="0,0,7,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ReminderSourceGlyph" Style="{StaticResource Icon}" FontSize="9.5" Margin="0,1,4,0"/>
                        <TextBlock x:Name="ReminderSourceText" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <TextBlock x:Name="ReminderTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14.5"
                               TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Assertive"/>
                  </DockPanel>
                  <TextBlock x:Name="ReminderBody" Foreground="{StaticResource TextSecondary}" FontSize="12" LineHeight="16"
                             MaxHeight="32" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="ReminderBadge" Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                           FontWeight="SemiBold" FontSize="20" Typography.NumeralAlignment="Tabular"/>
                <Button x:Name="ReminderJoin" Grid.Column="2" Style="{StaticResource PillButton}" Content="{Binding [Notch_Join], Source={x:Static l:Loc.Instance}}" Visibility="Collapsed"
                        Focusable="False" Click="ReminderJoin_Click" ToolTip="{Binding [Notch_JoinHint], Source={x:Static l:Loc.Instance}}"/>
                <Button x:Name="ReminderStop" Grid.Column="2" Style="{StaticResource OutlineButton}" Visibility="Collapsed"
                        Click="StopAdhan_Click" ToolTip="{Binding [Notch_StopAdhanHint], Source={x:Static l:Loc.Instance}}" AutomationProperties.Name="{Binding [Notch_StopAdhan], Source={x:Static l:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE198;" FontSize="12" Foreground="{StaticResource Sholat}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding [Notch_Stop], Source={x:Static l:Loc.Instance}}" Foreground="{StaticResource Sholat}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <!-- habit check-in: Sudah / Nanti -->
                <StackPanel x:Name="ReminderHabit" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed">
                  <Button Style="{StaticResource PillButton}" Background="{StaticResource Sholat}" Foreground="#000000"
                          Padding="13,5" FontSize="12" Content="{Binding [Notch_Done], Source={x:Static l:Loc.Instance}}" Focusable="False" Click="HabitDone_Click"
                          AutomationProperties.Name="{Binding [Notch_Done], Source={x:Static l:Loc.Instance}}"/>
                  <Button Style="{StaticResource OutlineButton}" Foreground="{StaticResource TextSecondary}" BorderBrush="#3A3A40"
                          Padding="12,5" Margin="6,0,0,0" Content="{Binding [Notch_Later], Source={x:Static l:Loc.Instance}}" Click="HabitSnooze_Click"
                          ToolTip="{Binding [Notch_LaterHint], Source={x:Static l:Loc.Instance}}" AutomationProperties.Name="{Binding [Notch_Later], Source={x:Static l:Loc.Instance}}"/>
                </StackPanel>
                <Button x:Name="ReminderRead" Grid.Column="2" Style="{StaticResource PillButton}" Background="{StaticResource Sholat}"
                        Foreground="#000000" Content="{Binding [Notch_Read], Source={x:Static l:Loc.Instance}}" Visibility="Collapsed" Focusable="False" Click="HadithRead_Click"
                        ToolTip="{Binding [Notch_ReadHint], Source={x:Static l:Loc.Instance}}"/>
              </Grid>
              <!-- PrayerSoon + dhikr: an invitation that says why, then the dhikr itself, centered across the card.
                   Top = 12 card margin + 32 context row + 8. Card height is fitted to this block from code. -->
              <StackPanel x:Name="ReminderDhikr" Margin="20,52,18,0" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="ReminderDhikrInvite" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                <!-- the focus: 24 DIP (20 if it won't fit on one line), line height 1.6, wraps rather than trims -->
                <TextBlock x:Name="ReminderDhikrArabic" Margin="0,10,0,0" FlowDirection="RightToLeft" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource ArabicFont}" FontSize="24"
                           LineHeight="38" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource TextPrimary}" xml:lang="ar"/>
                <TextBlock x:Name="ReminderDhikrLatin" Margin="0,6,0,0" FontSize="13" FontStyle="Italic" Foreground="#D6D6DB"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ReminderDhikrMeaning" Margin="0,2,0,0" FontSize="13" Foreground="#C8C8CE" LineHeight="18"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
              </StackPanel>
              <Rectangle x:Name="ReminderTrack" VerticalAlignment="Bottom" Height="3" Margin="30,0,30,10" RadiusX="1.5" RadiusY="1.5"
                         Fill="#1C1C20"/>
              <Rectangle x:Name="ReminderProgress" VerticalAlignment="Bottom" Height="3" Margin="30,0,30,10" RadiusX="1.5" RadiusY="1.5"
                         RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform><ScaleTransform x:Name="ReminderProgressScale" ScaleX="1"/></Rectangle.RenderTransform>
              </Rectangle>
            </Grid>

          </Grid>
        </Canvas>
      </Border>
      <Path x:Name="EarRight" Width="10" Height="10" VerticalAlignment="Top" Fill="{StaticResource Ink}" Data="M10,0 H0 V10 A10,10 0 0 1 10,0 Z"/>
    </StackPanel>
  </Grid>
</Window>
