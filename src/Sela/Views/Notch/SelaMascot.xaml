<UserControl x:Class="Sela.Views.Notch.SelaMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             Width="30" Height="30" IsHitTestVisible="False" Focusable="False">
    <UserControl.Resources>
        <!-- Crescent: a disc with an offset bite taken out, opening to the upper right. -->
        <CombinedGeometry x:Key="CrescentGeometry" GeometryCombineMode="Exclude" po:Freeze="True">
            <CombinedGeometry.Geometry1><EllipseGeometry Center="14,15.5" RadiusX="8" RadiusY="8" /></CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2><EllipseGeometry Center="18.5,12" RadiusX="7" RadiusY="7" /></CombinedGeometry.Geometry2>
        </CombinedGeometry>
        <SolidColorBrush x:Key="SunBrush" Color="#FFD36E" po:Freeze="True" />
        <SolidColorBrush x:Key="StarBrush" Color="#F2FFF8" po:Freeze="True" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3DDC97" po:Freeze="True" />
        <LinearGradientBrush x:Key="StreakBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="1" Color="#E6FFFFFF" />
        </LinearGradientBrush>
        <!-- Radial so the dawn light fades out on every side: no hard edges in the black pill. -->
        <RadialGradientBrush x:Key="HorizonBrush" po:Freeze="True">
            <GradientStop Offset="0" Color="#559DB4FF" />
            <GradientStop Offset="0.55" Color="#229DB4FF" />
            <GradientStop Offset="1" Color="#009DB4FF" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Dawn: faint lavender light rising from the bottom edge. -->
        <Ellipse x:Name="Horizon" Width="26" Height="14" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-4" Fill="{StaticResource HorizonBrush}" Opacity="0" IsHitTestVisible="False" />

        <!-- Night sky: tiny stars and the rare shooting star, all behind the figure. -->
        <Canvas x:Name="StarLayer">
            <Ellipse x:Name="Star1" Canvas.Left="3.5" Canvas.Top="5" Width="1.6" Height="1.6" Fill="{StaticResource StarBrush}" />
            <Ellipse x:Name="Star2" Canvas.Left="24.5" Canvas.Top="4" Width="1.2" Height="1.2" Fill="{StaticResource StarBrush}" />
            <Ellipse x:Name="Star3" Canvas.Left="25.5" Canvas.Top="19.5" Width="1.4" Height="1.4" Fill="{StaticResource StarBrush}" />
            <Ellipse x:Name="Star4" Canvas.Left="4" Canvas.Top="23" Width="1" Height="1" Fill="{StaticResource StarBrush}" />
        </Canvas>
        <Canvas>
            <Rectangle x:Name="Streak" Width="8" Height="0.8" RadiusX="0.4" RadiusY="0.4" Fill="{StaticResource StreakBrush}" Opacity="0">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="22" />
                        <TranslateTransform x:Name="StreakMove" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <!-- Excited pulse ring. -->
        <Ellipse x:Name="Ring" Width="22" Height="22" Stroke="{StaticResource AccentBrush}" StrokeThickness="1"
                 Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale" /></Ellipse.RenderTransform>
        </Ellipse>

        <!-- Everything below moves as one body: breathe, tilt, look, bounce. -->
        <Grid x:Name="Figure" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Breathe" />
                    <RotateTransform x:Name="Tilt" />
                    <TranslateTransform x:Name="Look" />
                    <TranslateTransform x:Name="Bounce" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse x:Name="Glow" Width="28" Height="28" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowStop" Offset="0" Color="#3DDC97" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid RenderTransformOrigin="0.5,0.55">
                <Grid.RenderTransform><ScaleTransform x:Name="Blink" /></Grid.RenderTransform>

                <Path x:Name="Moon" Data="{StaticResource CrescentGeometry}">
                    <Path.Fill><SolidColorBrush x:Name="MoonBrush" Color="#EAFBF3" /></Path.Fill>
                </Path>

                <Grid x:Name="Sun" Opacity="0">
                    <Path Stroke="{StaticResource SunBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85"
                          Data="M15,7.5 L15,5 M20.3,9.7 L22.07,7.93 M22.5,15 L25,15 M20.3,20.3 L22.07,22.07 M15,22.5 L15,25 M9.7,20.3 L7.93,22.07 M7.5,15 L5,15 M9.7,9.7 L7.93,7.93">
                        <Path.RenderTransform><RotateTransform x:Name="Rays" CenterX="15" CenterY="15" /></Path.RenderTransform>
                    </Path>
                    <Ellipse Width="11" Height="11" Fill="{StaticResource SunBrush}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
