<UserControl x:Class="Sela.Views.Notch.SelaMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="30" Height="30" IsHitTestVisible="False" Focusable="False">
    <!-- A 14 DIP "sky orb": a vertical sky gradient per phase, a hairline rim and a faint phase-tinted glow. -->
    <Grid ClipToBounds="True">
        <!-- Soft outer glow, tinted to the phase so the orb reads on pure black. -->
        <Ellipse x:Name="Glow" Width="26" Height="26" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowStop" Offset="0.45" Color="#2B3A67" />
                    <GradientStop Offset="1" Color="#00000000" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Prayer soon: the orb glows warm, a soft halo that slowly brightens and settles. -->
        <Ellipse x:Name="WarmGlow" Width="28" Height="28" Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0.4" Color="#FFC27A" />
                    <GradientStop Offset="1" Color="#00FFC27A" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>


        <!-- The orb: top -> bottom sky. Stop colors are tweened between phases. -->
        <Ellipse Width="14" Height="14">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop x:Name="SkyTop" Offset="0" Color="#0E1A3A" />
                    <GradientStop x:Name="SkyMid" Offset="0.55" Color="#1A2850" />
                    <GradientStop x:Name="SkyLow" Offset="1" Color="#2B3A67" />
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Faint top sheen gives the sphere a little volume without looking glossy. -->
        <Ellipse Width="14" Height="14">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.38,0.22" GradientOrigin="0.38,0.22" RadiusX="0.6" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#24FFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Prayer soon: warm light from inside the orb, rising from the bottom like a lamp. -->
        <Ellipse x:Name="WarmCore" Width="14" Height="14" Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.7" GradientOrigin="0.5,0.75" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Offset="0" Color="#CCFFD9A0" />
                    <GradientStop Offset="1" Color="#00FFC27A" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Single star highlight (night and dawn only). -->
        <Ellipse x:Name="Star" Width="1.6" Height="1.6" Fill="#F2F6FF" Opacity="0"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17.6,10.4,0,0" />

        <!-- Hairline rim. -->
        <Ellipse Width="14" Height="14" Stroke="#22FFFFFF" StrokeThickness="0.75" />
    </Grid>
</UserControl>
