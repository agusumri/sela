<!--
  Sela mark: a crescent moon resting inside a notch pill, with the notch "sensor" dot.
  Canvas is 256x256. SelaLogo is the detailed mark (32 px and up);
  SelaLogoSmall drops the dot, glow and rim and enlarges the pill + crescent for 16-24 px.
  Loaded by tools/make-icon.ps1 (XamlReader) and merged locally by Views/SettingsWindow.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="SelaLogo.Moon" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8AF5C6" Offset="0" />
        <GradientStop Color="#3DDC97" Offset="0.55" />
        <GradientStop Color="#22B477" Offset="1" />
    </LinearGradientBrush>

    <DrawingImage x:Key="SelaLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fixed bounds so every consumer scales the same 256 canvas -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />

                <!-- Rounded-square tile -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#222222" Offset="0" />
                            <GradientStop Color="#0B0B0B" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8,8,240,240" RadiusX="56" RadiusY="56" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Notch pill with a faint rim -->
                <GeometryDrawing Brush="#000000">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="3">
                            <Pen.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3A3A3A" Offset="0" />
                                    <GradientStop Color="#151515" Offset="1" />
                                </LinearGradientBrush>
                            </Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="32,82,192,92" RadiusX="46" RadiusY="46" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Soft glow behind the moon -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush>
                            <GradientStop Color="#553DDC97" Offset="0" />
                            <GradientStop Color="#003DDC97" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="114,128" RadiusX="46" RadiusY="40" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Crescent -->
                <GeometryDrawing Brush="{StaticResource SelaLogo.Moon}">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <EllipseGeometry Center="114,128" RadiusX="31" RadiusY="31" />
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <EllipseGeometry Center="127,118" RadiusX="25" RadiusY="25" />
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Notch sensor dot -->
                <GeometryDrawing Brush="#3DDC97">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="176,128" RadiusX="9" RadiusY="9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="SelaLogoSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />

                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2C2C2C" Offset="0" />
                            <GradientStop Color="#171717" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" RadiusX="52" RadiusY="52" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="#000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="16,64,224,128" RadiusX="64" RadiusY="64" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="#45E39F">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <EllipseGeometry Center="128,128" RadiusX="50" RadiusY="50" />
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <EllipseGeometry Center="150,110" RadiusX="38" RadiusY="38" />
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
