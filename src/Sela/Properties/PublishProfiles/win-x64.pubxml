<?xml version="1.0" encoding="utf-8"?>
<!-- Release build: one self-contained, compressed Sela.exe for win-x64.
     Usage: dotnet publish src/Sela/Sela.csproj -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- AdhanPlayer reads Assets\Audio\*.mp3 from AppContext.BaseDirectory. Bundling all content
         makes the runtime extract it (to %TEMP%\.net\Sela\<hash>) and point BaseDirectory there,
         so a lone downloaded Sela.exe still has the bundled adzan. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Keep referenced projects' .pdb (Sela.Core) out of the publish folder too. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\publish\</PublishDir>
  </PropertyGroup>
</Project>
